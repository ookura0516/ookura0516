<!-- 縦に2つに割れた鍵。上半分は金、下半分は淡い青（ふたりが半分ずつ持っている）。鍵の頭の穴には星。 -->
<defs>
  <clipPath id="top"><rect x="-600" y="-600" width="1200" height="600"/></clipPath>
  <clipPath id="bottom"><rect x="-600" y="0" width="1200" height="600"/></clipPath>
  <linearGradient id="goldG" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#FFE7A8"/><stop offset="1" stop-color="#E2AE4C"/></linearGradient>
  <linearGradient id="blueG" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#CFE0FF"/><stop offset="1" stop-color="#8FB2F0"/></linearGradient>
  <g id="keyshape">
    <path fill-rule="evenodd" d="
      M -230 -150 A 150 150 0 1 0 -230 150 A 150 150 0 1 0 -230 -150 Z
      M -230 -80 A 80 80 0 1 1 -230 80 A 80 80 0 1 1 -230 -80 Z"/>
    <rect x="-100" y="-36" width="420" height="72" rx="20"/>
    <rect x="170" y="20" width="52" height="104" rx="10"/>
    <rect x="252" y="20" width="52" height="78" rx="10"/>
  </g>
  <path id="sparkle" d="M 0 -62 C 8 -14 14 -8 62 0 C 14 8 8 14 0 62 C -8 14 -14 8 -62 0 C -14 -8 -8 -14 0 -62 Z"/>
</defs>
